{
  "manifest_version": 3,
  "name": "Marker:HELPER",
  "version": "1.1.0",
  "default_locale": "ja",
  "description": "__MSG_extDescription__",
  "permissions": ["sidePanel", "tabs", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Marker:HELPER",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-marking": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "__MSG_cmdToggleMarking__"
    },
    "jump-next-mark": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "__MSG_cmdJumpNext__"
    },
    "jump-prev-mark": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "__MSG_cmdJumpPrev__"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/label.js", "shared/cornerShape.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
